APP_NAME="NUSAMA3D"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Alamat resmi: http:// dan www. dialihkan permanen ke sini. Di production
# otomatis memakai APP_URL (isi APP_URL=https://nusama3d.com); baris ini hanya
# perlu dibuka bila alamat resminya berbeda dari APP_URL.
# APP_CANONICAL_URL=https://nusama3d.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nusaprint3d
DB_USERNAME=nusama3d
DB_PASSWORD=nus4m43D2026$

# Akun admin awal yang dibuat AdminUserSeeder — ganti sebelum dipakai online.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@nusama3d.com
ADMIN_PASSWORD=password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Kurs USD/IDR untuk Form Perhitungan SLA Industries.
#
# Bawaannya penyedia TANPA kunci API yang menerbitkan kurs REFERENSI HARIAN —
# angkanya tidak berubah sepanjang hari. Untuk kurs pasar intraday, ganti ke
# penyedia berbayar dan isi kuncinya. Daftar penyedianya ada di
# config/printing.php pada blok `usd_rate`.
USD_RATE_PROVIDER=open-er-api
EXCHANGERATE_HOST_KEY=

# Google tag (gtag.js) untuk Google Ads. Kosongkan untuk mematikannya —
# lingkungan pengembangan sebaiknya tidak ikut mengirim data ke akun iklan.
GOOGLE_ADS_ID=AW-17850382906
# Label konversi lead Google Ads (mis. AW-17850382906/AbCdEf). Opsional;
# bila diisi, halaman /terima-kasih juga mengirim event konversi ini.
GOOGLE_ADS_LEAD_CONVERSION=
# Google Tag Manager (mis. GTM-XXXXXXX). Opsional; event situs dikirim ke
# dataLayer untuk trigger Custom Event di GTM.
GTM_ID=

# Formulir publik → Lead Management (config/leads.php).
# Setiap kiriman diemailkan ke alamat ini (butuh MAIL_* yang benar).
LEAD_NOTIFY_EMAIL=cs@nusama3d.com
# reCAPTCHA v3 untuk Form Kontak (opsional). Kosong = honeypot + batas waktu.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Notifikasi WhatsApp status penawaran (config/whatsapp.php).
# WHATSAPP_DRIVER=log hanya mencatat pesan ke log; isi cloud_api untuk
# mengirim lewat WhatsApp Cloud API resmi Meta. Nomor PENGIRIM diatur dari
# dashboard (Pengaturan WhatsApp), bukan di sini.
WHATSAPP_DRIVER=log
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
# Nama template yang sudah disetujui Meta (4 variabel: nama, nomor penawaran,
# status, tanggal). Kosongkan untuk mengirim teks biasa.
WHATSAPP_STATUS_TEMPLATE=
WHATSAPP_TEST_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=id
