<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Alamat resmi: http://, www., dan kombinasinya dialihkan permanen ke
    # https://nusama3d.com (path & query tetap). Hanya untuk domain nusama3d.com,
    # jadi localhost tidak terpengaruh. X-Forwarded-Proto dicek agar tidak
    # berputar ketika HTTPS diakhiri di proxy/CDN (mis. Cloudflare).
    RewriteCond %{HTTP_HOST} ^www\.nusama3d\.com$ [NC]
    RewriteRule ^ https://nusama3d.com%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP_HOST} ^nusama3d\.com$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
    RewriteRule ^ https://nusama3d.com%{REQUEST_URI} [L,R=301]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Cache browser untuk aset statis (mempercepat kunjungan berikutnya).
# - /build: nama berkas memuat hash isi (Vite), aman di-cache selamanya.
# - gambar, font, ikon: 30 hari.
# Halaman HTML tidak terpengaruh dan tetap selalu diambil baru.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Berkas build Vite bernama "nama-HASH.js/css" (hash 8 karakter).
    <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2|wasm)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

